#!/bin/sh

# ============================================================
# Commit Message Cleanup
# ============================================================
#
# .gitmessageに書いてある
# 「#」から始まるガイド行をCommit直前に削除する。
#
# Fork上ではガイドを表示しつつ、
# 実際のCommit Historyには残さないためのHook。
# ============================================================


# GitからCommit Messageの一時ファイルが渡される。
MESSAGE_FILE="$1"


# ------------------------------------------------------------
# 「#」から始まる行を削除する
# ------------------------------------------------------------
#
# 例:
#
# feature(player): プレイヤー移動を追加
#
# # <type>(<scope>): <変更内容>
# # feature : 機能追加
#
# ↓
#
# feature(player): プレイヤー移動を追加
#
# だけがCommit Messageとして残る。
# ------------------------------------------------------------

sed -i '/^[[:space:]]*#/d' "$MESSAGE_FILE"


# ------------------------------------------------------------
# ファイル末尾の空行を削除する
# ------------------------------------------------------------

sed -i -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$MESSAGE_FILE"


exit 0